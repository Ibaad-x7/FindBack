# ============================================
# FindBack — root environment configuration
# Copy this file to `.env` in the project root and fill in real values.
# Both the backend (Express) and frontend (Vite) read from this one file.
# ============================================

# --- Backend (Express) ---
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL via Prisma) ---
# Replace USER, PASSWORD, and HOST with your own PostgreSQL credentials.
# Never commit real credentials — this file is a template only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/findback?schema=public"

# --- Frontend (Vite) ---
# Vite only exposes variables prefixed with VITE_ to client code.
# Leave empty for local dev — the Vite dev server proxies /api to the
# backend (see frontend/vite.config.ts). Set explicitly for production
# builds where frontend and backend are deployed separately.
VITE_API_URL=

# --- Auth (Step 3 — JWT authentication) ---
# Required. The backend fails auth requests safely (HTTP 500, no crash) if
# this is missing — it will NOT fall back to an insecure default secret.
# Generate a strong random value yourself, e.g.:
#   openssl rand -base64 32
# Do NOT put a real secret in this .env.example file — only in your local
# .env (which is gitignored).
JWT_SECRET=

# Optional. How long issued tokens stay valid. Defaults to 7d if unset.
JWT_EXPIRES_IN=7d
